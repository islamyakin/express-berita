<!DOCTYPE html>
<html lang="id">
<%- include("partials/head", { title: "Berita Lorem" }) %>
<body>
  <header>
    <a href="/" class="brand">Berita<span>Lorem</span></a>
    <a href="/berita/baru" class="btn">+ Tulis Berita</a>
  </header>
  <main>
    <form method="GET" action="/" class="search">
      <input type="text" name="q" placeholder="Cari berita..." value="<%= q %>" />
      <button type="submit" class="btn">Cari</button>
    </form>
    <% if (q && articles.length === 0) { %>
      <p>Tidak ada berita yang cocok dengan "<%= q %>".</p>
    <% } %>
    <div class="grid">
      <% articles.forEach(a => { %>
        <a href="/berita/<%= a.slug %>" class="card">
          <p class="category"><%= a.category %></p>
          <h2><%= a.title %></h2>
          <p class="date"><%= a.created_at %></p>
        </a>
      <% }) %>
    </div>
  </main>
</body>
</html>
